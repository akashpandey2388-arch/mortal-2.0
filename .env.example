# ==========================================
# MORTAL 2.0 Environment Configuration Template
# Provide variable names only. Never commit real secrets.
# ==========================================

# Port and Server Config
PORT=3000
NODE_ENV=development

# Database Configuration (Node 24 native node:sqlite file path or :memory:)
DATABASE_FILE=./mortal.db

# Ethereum / ENS Track (Sepolia Testnet)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
ENS_PARENT_NAME=mortal-sentinel.eth
ENS_NAME_WRAPPER_ADDRESS=0xab50971078225D365994dc1Edcb9b7FD72Bb4862
ENS_PUBLIC_RESOLVER_ADDRESS=0x6925affDa98274FE0376250187CCC4aC62866dCd

# Hedera Track (Testnet)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_VENDOR_ACCOUNT_ID=
HEDERA_VENDOR_PRIVATE_KEY=
HEDERA_FACILITATOR_ACCOUNT_ID=
HEDERA_FACILITATOR_PRIVATE_KEY=
HEDERA_HCS_TOPIC_ID=

# Simulation Flags (Set to "true" to force SIMULATED adapter in offline environments)
FORCE_SIMULATED_ENS=false
FORCE_SIMULATED_HEDERA=false
